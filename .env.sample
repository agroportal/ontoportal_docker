##################### General configuration ####################
# Docker Hub organization and per-image tags of the OntoPortal images
IMAGE_REPOSITORY=agroportal
API_TAG=master
NCBO_CRON_TAG=master
UI_TAG=master
# Service selection used by the ./ontoportal script (managed automatically)
SERVICE=ontoportal

##################### API configuration ####################
API_URL=http://localhost:9393

##################### UI configuration ####################
SITE=Ontoportal
ORG_URL=http://www.lirmm.fr
UI_URL=http://localhost
API_KEY=72c72cba-ad45-4785-b94e-483fa55cdddb
UI_THEME=ontoportal
FAIRNESS_DISABLED=false
NCBO_ANNOTATORPLUS_ENABLED=false
SUPPORT_EMAIL=sifrportal-support@lirmm.fr
RELEASE_VERSION="OntoPortal Appliance 3.0.1"
USE_RECAPTCHA=false
ANNOTATOR_URL="http://api-service:9393/annotator"

##################### O'FAIRe (FAIRness assessment) configuration ####################
# The service is built from github.com/agroportal/fairness (config/fairness/)
# and served by nginx on the API port. FAIRNESS_DISABLED above hides the
# feature in the UI.
#
# Where the UI reads the scores. The call is made by the UI *server*, so the
# internal address is the one that works locally. In a public deployment use
# the public URL instead (https://data.myportal.org/ofaire): it resolves from
# the UI container as well as from the browser, which the UI needs for the
# "raw JSON" link of the FAIR score panel.
FAIRNESS_URL=http://nginx:9393/ofaire
# Name of the portal assessed. Only O'FAIRe sees it; its configuration is
# generated under that name when the container starts.
FAIRNESS_PORTAL=ontoportal
# Where O'FAIRe reads the ontology metadata from (the API of this appliance)
FAIRNESS_API_URL=http://api:9393
# true: answer from the cache built by 'docker compose run --rm fairness
# fairness-cache', which provisioning runs once and cron should then refresh
# (an ontology added since the last build has no score until the next one).
# false: assess on every request, always fresh, but the UI gives up after 30s
# and a whole-portal request will exceed that as soon as the portal grows.
FAIRNESS_CACHE_ENABLED=true
# Apikey used to build the cache; defaults to API_KEY. An admin apikey gets
# the private ontologies assessed too.
FAIRNESS_ADMIN_APIKEY=
# Ref of github.com/agroportal/fairness to build, and extra JVM options
FAIRNESS_REF=master
FAIRNESS_JAVA_OPTS=

##################### NGINX (reverse proxy) configuration ####################
# Host ports published by nginx, the only public entry points of the appliance
# (keep UI_URL/API_URL above consistent if you change them)
NGINX_HTTP_PORT=80
NGINX_API_PORT=9393
# Max upload size (ontology submissions) and upstream response timeout
NGINX_MAX_BODY_SIZE=512m
NGINX_PROXY_READ_TIMEOUT=300s

##################### Provisioning (CRON) configuration #####################
# Ontology loaded at provisioning, from data/ontologies/<acronym>.json
STARTER_ONTOLOGY=STY

##################### KAMAL configuration ####################
IMAGE_NAME=
SERVER_IP=
DOCKER_REGISTRY_NAME=
KAMAL_REGISTRY_PASSWORD=
SSH_USER=
