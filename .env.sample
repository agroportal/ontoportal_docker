##################### General configuration ####################
# Docker Hub organization and tag for the OntoPortal images (api, cron, ui)
IMAGE_REPOSITORY=agroportal
IMAGE_TAG=development
# Service selection used by the ./ontoportal script (managed automatically)
SERVICE=ontoportal

##################### API configuration ####################
API_URL=http://localhost:9393

##################### UI configuration ####################
SITE=Ontoportal
ORG_URL=http://www.lirmm.fr
UI_URL=http://localhost
API_KEY=72c72cba-ad45-4785-b94e-483fa55cdddb
UI_THEME=ontoportal
FAIRNESS_DISABLED=false
NCBO_ANNOTATORPLUS_ENABLED=false
SUPPORT_EMAIL=sifrportal-support@lirmm.fr
RELEASE_VERSION="OntoPortal Appliance 3.0.1"
USE_RECAPTCHA=false
ANNOTATOR_URL="http://api-service:9393/annotator"

##################### NGINX (reverse proxy) configuration ####################
# Host ports published by nginx, the only public entry points of the appliance
# (keep UI_URL/API_URL above consistent if you change them)
NGINX_HTTP_PORT=80
NGINX_API_PORT=9393
# Max upload size (ontology submissions) and upstream response timeout
NGINX_MAX_BODY_SIZE=512m
NGINX_PROXY_READ_TIMEOUT=300s

##################### Provisioning (CRON) configuration #####################
OP_API_URL=https://data.bioontology.org
OP_APIKEY=8b5b7825-538d-40e0-9e9e-5ab9274a9aeb
STARTER_ONTOLOGY=STY

##################### KAMAL configuration ####################
IMAGE_NAME=
SERVER_IP=
DOCKER_REGISTRY_NAME=
KAMAL_REGISTRY_PASSWORD=
SSH_USER=
