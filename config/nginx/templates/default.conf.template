# OntoPortal reverse proxy: the single public entry point of the appliance.
#   :80    -> ui  (bioportal_web_ui / puma)
#   :9393  -> api (ontologies_api / unicorn, kept on its historical port)
#
# This is an nginx template: the image entrypoint substitutes the ${NGINX_*}
# placeholders from the container environment (set in docker-compose.yml) and
# installs the result as /etc/nginx/conf.d/default.conf, replacing the
# welcome-page config the image ships under the same name. Runtime nginx
# variables ($http_host, $remote_addr, ...) are left alone because envsubst
# only substitutes defined environment variables.

# Resolve upstreams through Docker's embedded DNS per request (variable +
# resolver) instead of at startup, so nginx also runs when only part of the
# stack is up ('./ontoportal start api') and answers 502 for the missing
# half. The trade-off is no upstream keepalive pooling.
resolver 127.0.0.11 valid=10s ipv6=off;

# Pass websocket upgrades through to the UI (Rails/ActionCable).
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# The query string of an O'FAIRe request, minus its portal parameter (see the
# /ofaire location for why it is dropped).
map $args $fairness_args {
    "~^(?<before>.*&)?portal=[^&]*&?(?<after>.*)$"  "$before$after";
    default                                         $args;
}

server_tokens off;

gzip on;
gzip_proxied any;
gzip_vary on;
gzip_comp_level 5;
gzip_min_length 1024;
gzip_types text/plain text/css application/javascript application/json application/ld+json application/xml image/svg+xml;

# UI
server {
    listen 80 default_server;
    server_name _;

    client_max_body_size ${NGINX_MAX_BODY_SIZE};

    # Answered by nginx itself; used by the docker healthcheck so it reflects
    # nginx health, not upstream health.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        set $ui_upstream http://ui:3000;
        proxy_pass $ui_upstream;

        proxy_http_version 1.1;
        # $http_host (not $host) keeps the port part, so Rails generates
        # correct absolute URLs when published on a non-default port.
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_read_timeout ${NGINX_PROXY_READ_TIMEOUT};
        proxy_redirect off;
    }
}

# API
server {
    listen 9393 default_server;
    server_name _;

    client_max_body_size ${NGINX_MAX_BODY_SIZE};

    # O'FAIRe (fairness assessment). It is served next to the API rather than
    # next to the UI because that is where its callers expect it (upstream
    # publishes it as services.<portal>/ofaire) and because everything it reads
    # comes from the API.
    #
    # The portal parameter is dropped on the way in. The UI derives it from
    # API_URL ($HOSTNAME.split('.')[0], bioportal_config_env.rb), which gives
    # 'agroportal' for https://data.agroportal.lirmm.fr but garbage for the
    # appliance's API_URL (http://api-service:9393) -- and O'FAIRe fails with
    # "portal configuration file not found" on an unknown portal instead of
    # falling back to its default. Without the parameter it uses the portal
    # named by SERVER_DEFAULT_PORTAL (FAIRNESS_PORTAL in .env), which is the
    # only one this appliance configures. Requests that carry their own url=
    # and apikey= (assessing a remote repository) are untouched: O'FAIRe
    # resolves those before it ever looks at portal.
    location /ofaire {
        # both set directives have to come before the rewrite: 'break' ends the
        # rewrite module for this location, and a set that follows it never runs
        set $args $fairness_args;
        set $fairness_upstream http://fairness:8080;
        # the webapp is deployed at the root of its Tomcat, so drop the prefix
        rewrite ^/ofaire/?(.*)$ /$1 break;

        proxy_pass $fairness_upstream;

        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # a request that misses the cache (&sync, or an ontology added since
        # the last cache build) runs the whole assessment inline
        proxy_read_timeout ${NGINX_PROXY_READ_TIMEOUT};
        proxy_redirect off;
    }

    location / {
        set $api_upstream http://api:9393;
        proxy_pass $api_upstream;

        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Search/annotator requests on large ontologies can legitimately be
        # slow; keep this above the API's own processing time.
        proxy_read_timeout ${NGINX_PROXY_READ_TIMEOUT};
        proxy_redirect off;
    }
}
